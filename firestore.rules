rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the user owns the document they are trying to access
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Collections using flat structure with userId field ──

    match /wrk_projects/{projectId} {
      allow read, write: if isAuthenticated() && (resource == null || isOwner(resource.data.userId)) && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /wrk_captures/{captureId} {
      allow read, write: if isAuthenticated() && (resource == null || isOwner(resource.data.userId)) && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /wrk_tasks/{taskId} {
      allow read, write: if isAuthenticated() && (resource == null || isOwner(resource.data.userId)) && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /wrk_notes/{noteId} {
      allow read, write: if isAuthenticated() && (resource == null || isOwner(resource.data.userId)) && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /wrk_links/{linkId} {
      allow read, write: if isAuthenticated() && (resource == null || isOwner(resource.data.userId)) && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ── Collections using user.uid directly as Document ID ──

    match /wrk_schema/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /wrk_workspaceConfig/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
